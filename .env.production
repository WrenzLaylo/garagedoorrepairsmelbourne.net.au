# Production build values. Committed on purpose: every VITE_* variable is compiled into the
# client bundle and is readable by anyone viewing source, so none of these are secrets.
# Without this file VITE_STANDALONE_ENQUIRIES is undefined at build time and the form silently
# reverts to the old garagedoorquote.net proxy.
#
# Real secrets (Turnstile SECRET key, SMTP, database) live only in the host config at
# /home/southeas/private/gdrm-enquiries/config.php and never appear in this repo.

# Legacy Elementor proxy. Unused while VITE_STANDALONE_ENQUIRIES=true, kept so the fallback
# path stays buildable.
VITE_QUOTE_FORM_ENDPOINT=/quote-submit.php

# Cloudflare Turnstile SITE key (public half of the pair).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADW3k29cgfInNEg6

# Must be exactly "true" or the form posts to the proxy instead of the first-party endpoint.
VITE_STANDALONE_ENQUIRIES=true
